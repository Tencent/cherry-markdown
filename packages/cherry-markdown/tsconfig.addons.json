{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "dist/addons",
    "rootDir": ".",
    "target": "ES2020",
    "strict": false,
    "noFallthroughCasesInSwitch": false,
    "moduleResolution": "bundler",
    "paths": {
      "@cherry-markdown/plugin-searcher": ["../../plugin/searcher/types/index.d.ts"]
    }
  },
  "include": ["src/addons/**/*-plugin.js"],
  "files": ["types/codemirror.d.ts", "types/global.d.ts"]
}
