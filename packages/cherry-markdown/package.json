{
  "name": "cherry-markdown",
  "license": "Apache-2.0",
  "version": "0.11.10",
  "type": "module",
  "description": "a new markdown editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/cherry-markdown.git",
    "directory": "packages/cherry-markdown"
  },
  "main": "./dist/cherry-markdown.js",
  "module": "./dist/cherry-markdown.esm.js",
  "style": "./dist/cherry-markdown.min.css",
  "types": "./dist/types/index.d.ts",
  "directories": {
    "example": "examples"
  },
  "files": [
    "dist",
    "types",
    "!types/env.d.ts"
  ],
  "sideEffects": [
    "./dist/*.css"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "iconfont": "node build/run-iconfont.js",
    "dev": "vp dev",
    "dev:vite": "vp dev",
    "build": "vp run clean && vp run build:all",
    "build:all": "vp run iconfont && vp run build:styles && vp run build:types && vp run build:addons && vp run build:full",
    "build:full": "NODE_ENV=production node build/vite.build.js",
    "build:core": "NODE_ENV=production node build/vite.build.js",
    "build:engine": "NODE_ENV=production node build/vite.build.js",
    "build:stream": "NODE_ENV=production node build/vite.build.js",
    "build:addons": "node build/addons.build.js",
    "build:types": "tsc --project tsconfig.json && node build/replacePaths.js",
    "build:styles": "NODE_ENV=production node build/styles.build.js",
    "clean": "rimraf ./dist",
    "check-bundle": "es-check es5 dist/cherry-markdown.js",
    "test": "vp test --exclude test/build/built-artifact-contract.spec.js",
    "test:artifacts": "vp test run test/build/built-artifact-contract.spec.js",
    "test:coverage": "COVERAGE_THRESHOLDS=true vp test run --coverage --exclude test/build/built-artifact-contract.spec.js",
    "test:update": "vp test -u --exclude test/build/built-artifact-contract.spec.js",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project test/tsconfig.json --noEmit",
    "examples": "serve -p 3000 ."
  },
  "keywords": [
    "markdown"
  ],
  "author": "Cherry Oteam",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-proposal-decorators": "^7.14.5",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.12.1",
    "@babel/plugin-proposal-optional-chaining": "^7.12.7",
    "@babel/plugin-transform-runtime": "^7.12.10",
    "@babel/runtime-corejs3": "^7.12.5",
    "babel-plugin-prismjs": "^2.1.0",
    "es-check": "^7.1.1",
    "fonteditor-core": "^2.6.3",
    "glob": "^8.0.3",
    "html2canvas": "^1.1.3",
    "es-toolkit": "^1.44.0",
    "mitt": "^3.0.0",
    "openai": "^5.9.0",
    "postcss": "^8.2.15",
    "prismjs": "^1.24.1",
    "replace-in-file": "^7.0.1",
    "rimraf": "^3.0.2",
    "sass": "^1.99.0",
    "serve": "^14.2.0",
    "svgicons2svgfont": "^15.0.1",
    "terser": "^5.49.2",
    "virtual-dom": "^2.1.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.40.0",
    "@lezer/highlight": "^1.2.1",
    "@replit/codemirror-vim": "^6.3.0",
    "dompurify": "^3.2.6",
    "htmlparser2": "^10.0.0",
    "jsdom": "~19.0.0"
  },
  "optionalDependencies": {
    "mermaid": "^11.14.0"
  }
}
