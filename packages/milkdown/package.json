{
  "name": "@cherry-markdown/milkdown",
  "version": "0.0.1",
  "type": "module",
  "description": "WYSIWYG Milkdown editor for Cherry Markdown",
  "keywords": [
    "cherry-markdown",
    "markdown",
    "milkdown",
    "prosemirror",
    "wysiwyg"
  ],
  "license": "Apache-2.0",
  "author": "Cherry Oteam",
  "homepage": "https://github.com/Tencent/cherry-markdown#readme",
  "bugs": {
    "url": "https://github.com/Tencent/cherry-markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/cherry-markdown.git",
    "directory": "packages/milkdown"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./styles.css",
    "./echarts": {
      "types": "./dist/renderers/echarts.d.ts",
      "import": "./dist/renderers/echarts.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "README.CN.md",
    "ARCHITECTURE.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/sync-chart-locale.mjs && node ./scripts/sync-cherry-helpers.mjs && node ./scripts/sync-cherry-prism.mjs && rimraf ./dist && tsc --project tsconfig.build.json && node ./scripts/sync-cherry-helpers.mjs --dist && node ./scripts/sync-cherry-prism.mjs --dist",
    "build:demo": "vp run -F cherry-markdown build && vp run build:demo:prepared",
    "build:demo:prepared": "vp run build && node ./scripts/build-demo.mjs",
    "build:types": "tsc --project tsconfig.build.json",
    "build:cherry-runtime": "NODE_ENV=production node ../cherry-markdown/build/vite.build.js --targets=engine-core-esm && node ../cherry-markdown/build/addons.build.js --targets=advance/cherry-table-echarts-plugin,advance/cherry-codeblock-echarts-plugin --formats=es",
    "clean": "rimraf ./dist",
    "dev:demo": "node ./scripts/sync-cherry-prism.mjs && vp dev --config vite.demo.config.mjs",
    "preview:demo": "vp preview --config vite.demo.config.mjs",
    "test": "vp run build:cherry-runtime && node ./scripts/sync-cherry-prism.mjs && vp test run --config vitest.config.ts",
    "test:coverage": "COVERAGE_THRESHOLDS=true vp run test",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:matrix": "MILKDOWN_BROWSER_MATRIX=1 vp run test:e2e",
    "test:consumer": "vp run -F cherry-markdown build && vp run build && vp run test:consumer:prepared",
    "test:consumer:prepared": "node ./scripts/verify-consumer.mjs",
    "test:consumer:ci": "node ./scripts/verify-consumer.mjs --artifacts=./artifacts/consumer/planned && node ./scripts/verify-consumer.mjs --artifacts=./artifacts/consumer/release --release",
    "test:artifacts": "node --test ./scripts/consumer-artifacts.test.mjs ./scripts/extract-image-pattern.test.mjs",
    "prepare:ci-artifacts": "vp run test:artifacts && node ./scripts/prepare-ci-artifacts.mjs --demo",
    "verify:demo-artifact": "node ./scripts/verify-ci-artifact.mjs",
    "typecheck": "node ./scripts/sync-cherry-helpers.mjs --check && tsc --project tsconfig.json --noEmit && tsc --project examples/react/tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@milkdown/kit": "^7.21.3",
    "cherry-markdown": "^0.11.12",
    "echarts": "^6.0.0",
    "mathlive": "^0.110.0",
    "mermaid": "^11.14.0",
    "prosemirror-view": "^1.42.3"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "mathlive": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@milkdown/kit": "^7.21.3",
    "@playwright/test": "^1.62.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "cherry-markdown": "*",
    "echarts": "^6.0.0",
    "mathlive": "^0.110.0",
    "mermaid": "^11.14.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prosemirror-view": "^1.42.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2"
  },
  "dependencies": {
    "prismjs": "^1.24.1",
    "remark-math": "^6.0.0"
  },
  "engines": {
    "node": ">=22",
    "yarn": ">=1.22.18"
  }
}
