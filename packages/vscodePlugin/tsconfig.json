{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "target": "es2020",
    "outDir": "out",
    "lib": ["es2020", "DOM"],
    "rootDir": ".",
    "moduleResolution": "node16",
    "types": ["node", "vscode", "mocha"],
    "noEmit": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "web-resources/scripts/**/*.ts", "vite.config.mts", "vitest.config.mts"],
  "exclude": ["node_modules", "dist", "web-resources/dist"]
}
