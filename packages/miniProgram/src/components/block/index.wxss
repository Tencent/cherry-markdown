.md-p {
  margin: 0 0 20rpx;
  color: var(--md-paragraph-color);
  font-size: var(--font-size-md);
  line-height: var(--md-paragraph-line-height);
}

.md-heading {
  margin: 28rpx 0 16rpx;
  color: var(--md-heading-color);
  font-weight: 700;
  line-height: 1.35;
}

.md-h1 {
  font-size: 44rpx;
}

.md-h2 {
  font-size: 38rpx;
}

.md-h3,
.md-h4,
.md-h5,
.md-h6 {
  font-size: 34rpx;
}

.md-blockquote {
  margin: 20rpx 0;
  padding: 16rpx 20rpx;
  border-left: 6rpx solid var(--md-blockquote-border);
  background: var(--md-blockquote-bg);
}

.md-list {
  margin: 12rpx 0 20rpx;
}

.md-list-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 8rpx 0;
}

.md-list-marker {
  width: 44rpx;
  color: #64748b;
  font-size: var(--font-size-md);
  line-height: var(--md-paragraph-line-height);
}

.md-list-body {
  flex: 1;
}

.md-table-shell {
  margin: 22rpx 0;
}
.md-table-scroll {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.md-table {
  flex-shrink: 0;
  min-width: 100%;
  border-top: 1rpx solid var(--md-table-border);
  border-left: 1rpx solid var(--md-table-border);
  background: var(--base-previewer-bg);
}

.md-table-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
}

.md-table-head {
  background: var(--secondary-color);
}

.md-table-cell {
  box-sizing: border-box;
  width: 252rpx;
  flex: 0 0 252rpx;
  padding: 14rpx 16rpx;
  border-right: 1rpx solid var(--md-table-border);
  border-bottom: 1rpx solid var(--md-table-border);
  color: var(--md-paragraph-color);
  font-size: 28rpx;
  line-height: 1.6;
}

.md-table-th {
  font-weight: 700;
}

.md-code-card {
  overflow: hidden;
  margin: 22rpx 0;
  border: 1rpx solid #d8dee4;
  border-radius: 8rpx;
  background: var(--base-previewer-bg);
}

.md-code-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
  color: var(--base-font-color);
  font-size: 24rpx;
}

.md-copy {
  margin: 0;
  padding: 0 18rpx;
  border-radius: 6rpx;
  background: var(--base-previewer-bg);
  color: var(--base-font-color);
  font-size: 24rpx;
  line-height: 48rpx;
}

.md-code {
  display: block;
  padding: 20rpx;
  color: var(--base-font-color);
  font-family: Menlo, Monaco, Consolas, monospace;
  font-size: 26rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.md-code-token {
  color: var(--base-font-color);
}

.md-code-comment {
  color: var(--base-sub-font-color);
}

.md-code-keyword {
  color: var(--primary-color);
}

.md-code-string {
  color: var(--md-link-color);
}

.md-code-number {
  color: var(--md-inline-code-color);
}

.md-code-operator,
.md-code-punctuation {
  color: var(--md-link-color);
}

.md-image {
  display: block;
  width: 100%;
  margin: 18rpx 0;
  border-radius: 8rpx;
  background: #eef2f7;
}

.md-image-placeholder {
  display: block;
  margin: 18rpx 0;
  padding: 20rpx;
  border: 1rpx dashed #cbd5e1;
  border-radius: 8rpx;
  background: var(--md-blockquote-bg);
  color: #64748b;
  font-size: 26rpx;
}

:host {
  display: block;
}
.md-list-body {
  min-width: 0;
}
.md-list-marker {
  flex-shrink: 0;
}
.md-rule {
  height: 1px;
  margin: 24rpx 0;
  background: var(--md-table-border);
}
.md-unsupported {
  margin: 16rpx 0;
  color: #64748b;
}
.md-source-card {
  margin: 20rpx 0;
  background: var(--secondary-color);
  border-radius: 8rpx;
}
.md-source {
  display: block;
  padding: 20rpx;
  white-space: pre-wrap;
  font-size: 26rpx;
}

.md-group {
  padding: 16rpx;
  margin: 20rpx 0;
  border-left: 4rpx solid var(--primary-color);
  background: var(--md-blockquote-bg);
}

.md-theme { color: var(--base-font-color); }
.md-group-head { display: flex; flex-direction: row; justify-content: space-between; font-weight: bold; color: var(--md-heading-color); margin-bottom: 12rpx; }

.md-detail-toggle { width: 100%; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; font-size: inherit; line-height: 1.6; text-align: left; }
