.md-p {
  margin: 0 0 20rpx;
  color: #24292f;
  font-size: 30rpx;
  line-height: 1.75;
}

.md-heading {
  margin: 28rpx 0 16rpx;
  color: #111827;
  font-weight: 700;
  line-height: 1.35;
}

.md-h1 {
  font-size: 44rpx;
}

.md-h2 {
  font-size: 38rpx;
}

.md-h3,
.md-h4,
.md-h5,
.md-h6 {
  font-size: 34rpx;
}

.md-blockquote {
  margin: 20rpx 0;
  padding: 16rpx 20rpx;
  border-left: 6rpx solid #cbd5e1;
  background: #f8fafc;
}

.md-list {
  margin: 12rpx 0 20rpx;
}

.md-list-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 8rpx 0;
}

.md-list-marker {
  width: 44rpx;
  color: #64748b;
  font-size: 30rpx;
  line-height: 1.75;
}

.md-list-body {
  flex: 1;
}

.md-table-shell {
  margin: 22rpx 0;
}
.md-table-scroll {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.md-table {
  flex-shrink: 0;
  min-width: 100%;
  border-top: 1rpx solid #d0d7de;
  border-left: 1rpx solid #d0d7de;
  background: #ffffff;
}

.md-table-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
}

.md-table-head {
  background: #f6f8fa;
}

.md-table-cell {
  box-sizing: border-box;
  width: 252rpx;
  flex: 0 0 252rpx;
  padding: 14rpx 16rpx;
  border-right: 1rpx solid #d0d7de;
  border-bottom: 1rpx solid #d0d7de;
  color: #24292f;
  font-size: 28rpx;
  line-height: 1.6;
}

.md-table-th {
  font-weight: 700;
}

.md-code-card {
  overflow: hidden;
  margin: 22rpx 0;
  border: 1rpx solid #d8dee4;
  border-radius: 8rpx;
  background: #0f172a;
}

.md-code-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #cbd5e1;
  font-size: 24rpx;
}

.md-copy {
  margin: 0;
  padding: 0 18rpx;
  border-radius: 6rpx;
  background: #ffffff;
  color: #0f172a;
  font-size: 24rpx;
  line-height: 48rpx;
}

.md-code {
  display: block;
  padding: 20rpx;
  color: #e2e8f0;
  font-family: Menlo, Monaco, Consolas, monospace;
  font-size: 26rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.md-code-token {
  color: #e2e8f0;
}

.md-code-comment {
  color: #94a3b8;
}

.md-code-keyword {
  color: #93c5fd;
}

.md-code-string {
  color: #86efac;
}

.md-code-number {
  color: #fbbf24;
}

.md-code-operator,
.md-code-punctuation {
  color: #c4b5fd;
}

.md-image {
  display: block;
  width: 100%;
  margin: 18rpx 0;
  border-radius: 8rpx;
  background: #eef2f7;
}

.md-image-placeholder {
  display: block;
  margin: 18rpx 0;
  padding: 20rpx;
  border: 1rpx dashed #cbd5e1;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 26rpx;
}

:host {
  display: block;
}
.md-list-body {
  min-width: 0;
}
.md-list-marker {
  flex-shrink: 0;
}
.md-rule {
  height: 1px;
  margin: 24rpx 0;
  background: #d0d7de;
}
.md-unsupported {
  margin: 16rpx 0;
  color: #64748b;
}
.md-source-card {
  margin: 20rpx 0;
  background: #f1f5f9;
  border-radius: 8rpx;
}
.md-source {
  display: block;
  padding: 20rpx;
  white-space: pre-wrap;
  font-size: 26rpx;
}

.md-group {
  padding: 16rpx;
  margin: 20rpx 0;
  border-left: 4rpx solid #1677ff;
  background: #f8fafc;
}
