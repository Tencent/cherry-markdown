<view class="md-theme md-context-{{context}}" style="{{themeStyle}}">
<view wx:if="{{block.type === 'panel' || block.type === 'detail'}}" class="md-group md-{{block.type}}" style="{{panelStyle}}">
  <view wx:if="{{block.type === 'detail'}}" class="md-group-head md-detail-toggle" bindtap="toggleDetail"><text class="md-detail-arrow">{{detailOpen ? '▲' : '▼'}}</text><text>{{block.title}}</text><button class="md-detail-hit" aria-label="{{block.title}}" catchtap="toggleDetail" /></view>
  <view wx:else class="md-group-head"><text>{{block.title}}</text></view>
  <view wx:if="{{block.type === 'panel' || detailOpen}}" class="md-group-body"><cherry-block wx:for="{{block.children}}" wx:key="id" block="{{item}}" theme="{{theme}}" text-color="{{block.type === 'panel' ? panelTextColor : '--accordion-body-color'}}" context="{{block.type === 'detail' && index === block.children.length - 1 ? 'detail-last' : ''}}" /></view>
</view>
<view wx:elif="{{block.type === 'paragraph' || block.type === 'heading'}}" class="md-p {{block.type === 'heading' ? 'md-heading md-h' + block.level : 'md-paragraph'}}">
  <cherry-inlines theme="{{theme}}" text-color="{{block.type === 'heading' ? '--md-heading-color' : textColor}}" nodes="{{block.inlines}}" />
</view>
<view wx:elif="{{block.type === 'blockquote'}}" class="md-blockquote">
  <cherry-block wx:for="{{block.children}}" wx:key="id" block="{{item}}" theme="{{theme}}" context="quote" text-color="{{textColor}}" />
</view>
<view wx:elif="{{block.type === 'list'}}" class="md-list">
  <view wx:for="{{block.children}}" wx:key="id" class="md-list-item">
    <view class="md-list-marker" style="color:var({{textColor}});"><view wx:if="{{item.task}}" class="md-checkbox"><text>{{item.checked ? '✓' : ''}}</text></view><text wx:else>{{block.ordered ? item.marker : listDepth % 3 === 1 ? '◦' : listDepth % 3 === 2 ? '▪' : '•'}}</text></view>
    <view class="md-list-body">
      <cherry-block wx:for="{{item.children}}" wx:key="id" wx:for-item="child" block="{{child}}" theme="{{theme}}" context="list" list-depth="{{listDepth + 1}}" text-color="{{textColor}}" />
    </view>
  </view>
</view>
<view wx:elif="{{block.type === 'table'}}" class="md-table-shell">
  <scroll-view wx:if="{{tableHeight > 0}}" class="md-table-scroll" scroll-x="{{true}}" enable-flex="{{true}}" type="custom" scroll-left="{{tableScrollLeft}}" bindscroll="tableScrolled" style="height: {{tableHeight}}px;">
    <template is="table" data="{{block, tableWidth, theme}}" />
  </scroll-view>
  <template wx:else is="table" data="{{block, tableWidth, theme}}" />
</view>
<view wx:elif="{{block.type === 'code_block'}}" class="md-code-card">
  <view class="md-code-head">
    <text>{{block.lang}}</text>
    <button class="md-copy" size="mini" data-text="{{block.text}}" bindtap="copyCode">复制</button>
  </view>
  <scroll-view scroll-x="{{true}}" class="md-code-scroll" type="custom" style="height: {{codeHeight}}px;"><text class="md-code" style="width: {{codeWidth}}px;" user-select="{{true}}"><text wx:for="{{block.runs}}" wx:key="id" class="{{item.className}}">{{item.text}}</text></text></scroll-view>
</view>
<view wx:elif="{{block.type === 'math_block' || block.type === 'diagram'}}" class="md-source-card">
  <view class="md-code-head">
    <text>{{block.type === 'diagram' ? 'Mermaid 源码' : '公式源码'}}</text>
    <button class="md-copy" size="mini" data-text="{{block.source || block.text}}" bindtap="copyCode">复制</button>
  </view>
  <text class="md-source" user-select="{{true}}">{{block.text}}</text>
</view>
<image wx:elif="{{block.type === 'image'}}" class="md-image" src="{{block.src}}" mode="widthFix" lazy-load="{{true}}" data-src="{{block.src}}" bindtap="previewImage" />
<view wx:elif="{{block.type === 'image_placeholder'}}" class="md-image-placeholder"><text>{{block.text}}</text></view>
<view wx:elif="{{block.type === 'thematic_break'}}" class="md-rule" />
<view wx:elif="{{block.type === 'unsupported'}}" class="md-unsupported"><text user-select="{{true}}">{{block.text}}</text></view>

</view>
<template name="table">
  <view class="md-table" style="width: {{tableWidth}}px;">
    <view wx:for="{{block.header}}" wx:key="id" class="md-table-row md-table-head">
      <view wx:for="{{item.cells}}" wx:key="id" wx:for-item="cell" class="md-table-cell md-table-th" style="text-align: {{cell.align || 'center'}};">
        <cherry-inlines theme="{{theme}}" nodes="{{cell.inlines}}" data-cell="{{cell.id}}" bind:layoutchange="tableImageLoaded" />
      </view>
    </view>
    <view wx:for="{{block.rows}}" wx:key="id" class="md-table-row">
      <view wx:for="{{item.cells}}" wx:key="id" wx:for-item="cell" class="md-table-cell" style="text-align: {{cell.align || 'left'}};">
        <cherry-inlines theme="{{theme}}" nodes="{{cell.inlines}}" data-cell="{{cell.id}}" bind:layoutchange="tableImageLoaded" />
      </view>
    </view>
  </view>
</template>
