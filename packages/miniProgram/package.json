{
  "name": "@cherry-markdown/miniprogram",
  "version": "0.0.2",
  "type": "module",
  "description": "MiniProgram adapters for Cherry Markdown",
  "keywords": [
    "cherry-markdown",
    "markdown",
    "wechat-miniprogram",
    "miniprogram"
  ],
  "license": "Apache-2.0",
  "author": "Cherry Oteam",
  "homepage": "https://github.com/Tencent/cherry-markdown#readme",
  "bugs": {
    "url": "https://github.com/Tencent/cherry-markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/cherry-markdown.git",
    "directory": "packages/miniProgram"
  },
  "main": "./dist/miniProgram.esm.js",
  "module": "./dist/miniProgram.esm.js",
  "types": "./dist/types/miniProgram.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/miniProgram.d.ts",
      "import": "./dist/miniProgram.esm.js"
    },
    "./package.json": "./package.json",
    "./components/*": "./dist/components/*"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.CN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run clean && vp run build:esm && vp run build:components && vp run build:types",
    "build:esm": "NODE_ENV=production node build/vite.build.js",
    "build:types": "tsc --project tsconfig.json && node build/types.js",
    "clean": "rimraf ./dist",
    "test": "vp test run --config vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project test/tsconfig.json --noEmit",
    "build:components": "NODE_ENV=production node build/components.js",
    "test:artifact": "node test/build/verify-native.mjs"
  },
  "dependencies": {
    "htmlparser2": "^10.0.0",
    "entities": "^7.0.1"
  },
  "devDependencies": {
    "rimraf": "^3.0.2"
  },
  "engines": {
    "node": ">=22",
    "yarn": ">=1.22.18"
  }
}
