{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "declaration": true,
    "declarationDir": "dist/types",
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "./src",
    "strict": true,
    "paths": {
      "@/*": ["../cherry-markdown/src/*"],
      "~types/*": ["../cherry-markdown/types/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/node_modules/**", "dist"]
}
