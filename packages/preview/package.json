{
  "name": "@cherry-markdown/preview",
  "license": "Apache-2.0",
  "version": "0.0.1",
  "type": "module",
  "description": "Pure markdown preview renderer for Cherry Markdown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/cherry-markdown.git",
    "directory": "packages/preview"
  },
  "main": "./dist/cherry-markdown-preview.cjs",
  "module": "./dist/cherry-markdown-preview.esm.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/cherry-markdown-preview.esm.js",
      "require": "./dist/cherry-markdown-preview.cjs",
      "default": "./dist/cherry-markdown-preview.esm.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build/vite.build.js && tsc --project tsconfig.json",
    "build:types": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vp test",
    "clean": "rimraf ./dist"
  },
  "keywords": [
    "markdown",
    "preview"
  ],
  "author": "Cherry Oteam",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cherry-markdown/engine": "^0.0.1",
    "dompurify": "^3.2.6",
    "virtual-dom": "^2.1.1"
  },
  "sideEffects": false
}
