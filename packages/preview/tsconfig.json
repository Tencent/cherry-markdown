{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "declarationDir": "dist/types",
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "./src",
    "strict": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": ["./src/*"],
      "~types/*": ["./types/*"]
    },
    "experimentalDecorators": true
  },
  "include": ["src/index.js"],
  "exclude": ["**/node_modules/**", "dist"],
  "files": ["types/env.d.ts"]
}
