{
  "name": "@cherry-markdown/workspaces",
  "description": "a new markdown editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/cherry-markdown.git"
  },
  "author": "Cherry Oteam",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/react_demo",
    "examples/miniProgram"
  ],
  "scripts": {
    "postinstall": "vp run -F cherry-markdown iconfont",
    "prepare": "husky",
    "changeset": "npx @changesets/cli",
    "changeset-version": "npx @changesets/cli version",
    "dev": "vp run dev:core",
    "dev:core": "vp dev --config packages/cherry-markdown/vite.config.ts",
    "build": "vp run -F cherry-markdown build && vp run -F @cherry-markdown/miniprogram build && vp run -F @cherry-markdown/mini-program-demo build && vp run -F @cherry-markdown/react_demo build && vp run -F @cherry-markdown/client build && vp run -F cherry-markdown-vscode-plugin build",
    "build:core": "vp run -F cherry-markdown build",
    "build:miniProgram": "vp run -F @cherry-markdown/miniprogram build",
    "dev:client": "vp run -F @cherry-markdown/client tauri:dev",
    "build:client": "vp run -F @cherry-markdown/client build",
    "build:vscodePlugin": "vp run -F cherry-markdown build && vp run -F cherry-markdown-vscode-plugin build",
    "example:react": "vp run -F @cherry-markdown/react_demo dev",
    "test": "vp run -F cherry-markdown test && vp run -F @cherry-markdown/miniprogram test",
    "test:core": "vp run -F cherry-markdown test",
    "test:miniProgram": "vp run -F @cherry-markdown/miniprogram test",
    "test:update": "vp run -F cherry-markdown test:update",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "typecheck": "vp run -F cherry-markdown typecheck && vp run -F @cherry-markdown/miniprogram typecheck",
    "typecheck:core": "vp run -F cherry-markdown typecheck",
    "typecheck:miniProgram": "vp run -F @cherry-markdown/miniprogram typecheck",
    "validate": "vp check"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-env": "^7.28.0",
    "@changesets/cli": "^2.29.5",
    "@cherry-markdown/changesets-changelog-github": "^0.0.1",
    "@commitlint/config-conventional": "21.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/typescript-plugin": "^3.2.2",
    "commitlint": "21.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-tencent": "^1.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "husky": "~9.1.7",
    "prettier": "^3.9.3",
    "typescript": "^6.0.2",
    "vite": "^8.2.1",
    "vite-plus": "0.2.6",
    "vitest": "4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.2"
  },
  "engines": {
    "node": ">=22",
    "yarn": ">=1.22.18"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
