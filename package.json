{
  "name": "@cherry-markdown/workspaces",
  "description": "a new markdown editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/cherry-markdown.git"
  },
  "author": "Cherry Oteam",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter cherry-markdown run iconfont",
    "prepare": "husky",
    "changeset": "npx @changesets/cli",
    "changeset-version": "npx @changesets/cli version",
    "dev": "pnpm --filter cherry-markdown dev",
    "build": "pnpm --filter cherry-markdown build",
    "dev:client": "pnpm --filter @cherry-markdown/client tauri dev",
    "build:client": "pnpm --filter @cherry-markdown/client tauri build",
    "build:vscodePlugin": "pnpm --filter cherry-markdown build && pnpm --filter cherry-markdown-vscode-plugin build",
    "example:react": "pnpm --filter @cherry-markdown/react_demo dev",
    "test": "pnpm --filter cherry-markdown test",
    "test:update": "pnpm --filter cherry-markdown test:update",
    "lint:all": "pnpm --filter cherry-markdown lint && pnpm --filter @cherry-markdown/client lint && pnpm --filter cherry-markdown-vscode-plugin lint",
    "lint:fix:all": "pnpm --filter cherry-markdown lint:fix && pnpm --filter @cherry-markdown/client lint:fix && pnpm --filter cherry-markdown-vscode-plugin lint:fix"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.0",
    "@changesets/cli": "^2.29.5",
    "@cherry-markdown/changesets-changelog-github": "^0.0.1",
    "@commitlint/config-conventional": "21.0.0",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "commitlint": "21.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-tencent": "^1.1.3",
    "eslint-plugin-prettier": "^5.5.1",
    "husky": "~9.1.7",
    "lint-staged": "~12.5.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.2",
    "vite": "^6.4.1",
    "vitest": "^3.1.3",
    "vue-eslint-parser": "^10.2.0"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.ts": "eslint --fix",
    "*.{js,ts,json,md}": "prettier --write"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "glob-parent": "5.1.2",
      "set-value": "4.0.1",
      "lodash.template": "4.5.0",
      "yargs-parser": "20.2.9",
      "xmldom": "0.5.0",
      "ansi-regex": "5.0.1",
      "glob-watcher": "6.0.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "core-js-pure",
      "esbuild",
      "ttf2woff2"
    ]
  },
  "packageManager": "pnpm@10.11.0"
}
