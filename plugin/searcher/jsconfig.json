    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*.js", "types/**/*.d.ts"]
}
