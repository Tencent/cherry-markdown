{
  "name": "@cherry-markdown/plugin-searcher",
  "version": "0.1.0",
  "description": "Cherry Markdown 搜索插件（TEditor 风格）",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/cherry-markdown.git",
    "directory": "plugin/searcher"
  },
  "main": "./dist/cherry-searcher-plugin.js",
  "module": "./dist/cherry-searcher-plugin.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cherry-searcher-plugin.esm.js",
      "require": "./dist/cherry-searcher-plugin.js"
    },
    "./styles/searcher.scss": "./src/styles/searcher.scss"
  },
  "files": [
    "README.md",
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "node build/rollup.build.js",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "cherry-markdown": ">=0.11.0"
  },
  "dependencies": {
    "lodash": "^4.17.20"
  },
  "devDependencies": {
    "@babel/core": "^7.7.2",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-proposal-decorators": "^7.14.5",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.12.1",
    "@babel/plugin-proposal-optional-chaining": "^7.12.7",
    "@babel/plugin-transform-runtime": "^7.12.10",
    "@babel/preset-env": "^7.7.1",
    "@babel/runtime-corejs3": "^7.12.5",
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-terser": "^0.4.3",
    "rollup": "4.52.3",
    "vitest": "^3.1.3"
  }
}
